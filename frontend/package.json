{
  "name": "acompanhaai-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "check:bundle": "node scripts/check-bundle.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "lint": "eslint src",
    "format": "prettier --write src scripts angular.json proxy.conf.json package.json eslint.config.mjs vitest.config.mjs",
    "format:check": "prettier --check src scripts angular.json proxy.conf.json package.json eslint.config.mjs vitest.config.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "^22.13.0 || ^24.0.0",
    "npm": ">=10.9.2 <12"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/manrope": "5.2.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "21.4.0",
    "axe-core": "4.14.0",
    "eslint": "^10.14.0",
    "jsdom": "28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "4.1.12"
  }
}
