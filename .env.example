# O Compose le .env; essas credenciais inicializam somente um volume novo.
# Nao reutilizar a senha administrativa como senha da API ou do Flyway.
POSTGRES_ADMIN_PASSWORD=
DB_PORT=5432
# O Spring Boot precisa receber estas variaveis no ambiente do processo.
# Somente para os perfis postgres-separated / postgres-runtime.
APP_DB_PASSWORD=
MIGRATION_DB_PASSWORD=
